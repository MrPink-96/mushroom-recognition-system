FROM node:20-alpine

RUN addgroup -g 1000 -S appgroup && \
    adduser -u 1000 -S appuser -G appgroup

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --only=production

COPY .next/ ./.next/
COPY public/ ./public/

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 3000

CMD ["npm", "start"]